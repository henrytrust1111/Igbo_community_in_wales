DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL — used by metadataBase, sitemap.xml, robots.txt, and JSON-LD.
# In production, set this to your real origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_ADDRESS=

# Recipient address for the public contact form (POST /api/contact)
CONTACT_EMAIL=.......@example.com
